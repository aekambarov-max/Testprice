# --- Обязательные ---
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=price2test.kmg.kz,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://price2test.kmg.kz,http://localhost:8080
PORTAL_BASE_URL=https://price2test.kmg.kz

# --- Почта (уведомления, запросы КП) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.kmg.kz
EMAIL_PORT=25
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=price@kmg.kz

# --- Подмодуль «Маркетинговый анализ» (значения по умолчанию, см. README) ---
MA_ENABLED=true
MA_MIN_KP_COUNT=1
MA_DZO_APPROVERS_SAME_DZO_ONLY=true
MA_ALLOW_SKIP_DZO_STAGE=false
MA_RESTART_ROUTE_FROM_BEGINNING=true
MA_DB_STAGE_ASSIGNMENT=role
MA_KMG_DEVIATION_CHECK_ENABLED=false
MA_KMG_DEVIATION_THRESHOLD_PERCENT=15
MA_NUMBER_PREFIX=ID
MA_PRICE_CALC_METHOD=average
MA_ALLOW_AUTHOR_AS_APPROVER=false
MA_MAX_UPLOAD_MB=25
VAT_RATE_PERCENT=16
